# PitchLens runs fully offline by default (PITCHLENS_MODE=mock).
# Set PITCHLENS_MODE=azure and fill in the services you want to enable;
# any service left blank silently falls back to its local mock.
PITCHLENS_MODE=mock

# Azure OpenAI / Azure AI Foundry (Explainer, Personalizer, Recap agents)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-10-21

# Azure AI Translator (Translator agent)
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=westeurope
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com

# Azure AI Speech (Voice agent, TTS of the narrative line)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope

# Azure Event Hubs (live event ingest)
AZURE_EVENTHUB_CONNECTION_STRING=
AZURE_EVENTHUB_NAME=match-events

# Azure Web PubSub (fan-out of overlay instructions to clients)
AZURE_WEBPUBSUB_CONNECTION_STRING=
AZURE_WEBPUBSUB_HUB=pitchlens

# Azure Blob Storage (rendered assets, timelines, recap cards)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=pitchlens-assets

# Optional local real-clip path for development (never committed)
PITCHLENS_LOCAL_CLIP=data/test_assets/vizuals_test.mp4
